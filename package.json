{
  "name": "wealth-data-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:push": "python scripts/collector/init_db.py && prisma generate",
    "collect": "python scripts/collector/run_daily.py",
    "collect:seed": "python scripts/collector/run_daily.py --seed",
    "collect:backfill": "python scripts/collector/run_backfill.py",
    "collect:backfill:full": "python scripts/collector/run_backfill.py --full",
    "collect:fund-profiles": "python scripts/collector/run_fund_profiles.py --limit 23030",
    "collect:fund-extras": "python scripts/collector/run_fund_extras.py",
    "collect:fund-dividends": "python scripts/collector/run_fund_dividends.py"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.49",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  }
}
